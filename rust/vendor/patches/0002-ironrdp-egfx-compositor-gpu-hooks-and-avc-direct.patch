+/// Split a start-code-delimited Annex B access unit into complete NAL units,
+/// excluding start codes and trailing zero bytes.
+pub fn annex_b_units(mut data: &[u8]) -> impl Iterator<Item = &[u8]> {
+    let start = |bytes: &[u8]| bytes.windows(3).position(|prefix| prefix == [0, 0, 1]);
+    data = start(data).map_or(&[], |index| &data[index + 3..]);
+    core::iter::from_fn(move || {
+        loop {
+            if data.is_empty() {
+                return None;
+            }
+            let (nal, rest) = start(data).map_or((data, &[][..]), |end| (&data[..end], &data[end + 3..]));
+            data = rest;
+            if let Some(last) = nal.iter().rposition(|byte| *byte != 0) {
+                return Some(&nal[..=last]);
+            }
+        }
+    })
+}
