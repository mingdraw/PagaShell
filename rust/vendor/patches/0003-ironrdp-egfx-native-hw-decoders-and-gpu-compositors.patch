+@property(nonatomic, strong) id<MTLTexture> color;
+@property(nonatomic, strong) id<MTLTexture> avcY;
+@property(nonatomic, strong) id<MTLTexture> avcU;
+@property(nonatomic, strong) id<MTLTexture> avcV;
+@property(nonatomic, assign) size_t bytes;
+@property(nonatomic, assign) BOOL mapped;
+@property(nonatomic, assign) uint32_t originX;
+@property(nonatomic, assign) uint32_t originY;
+@property(nonatomic, assign) uint32_t targetW;
+@property(nonatomic, assign) uint32_t targetH;
+@property(nonatomic, assign) BOOL painted;
+@end
+
+@implementation PagaMetalSurface
+@end
+
+@interface PagaMetalCacheEntry : NSObject
+@property(nonatomic, assign) uint16_t width;
+@property(nonatomic, assign) uint16_t height;
+@property(nonatomic, strong) id<MTLTexture> texture;
+@property(nonatomic, assign) size_t bytes;
+@end
+
+@implementation PagaMetalCacheEntry
+@end
+
+@interface PagaMetalState : NSObject {
+ @public
+  id<MTLDevice> device;
+  id<MTLCommandQueue> queue;
+  CVMetalTextureCacheRef textureCache;
+  id<MTLComputePipelineState> avc420Pipe;
+  id<MTLComputePipelineState> avc444MainPipe;
+  id<MTLComputePipelineState> avc444AuxV1Pipe;
+  id<MTLComputePipelineState> avc444AuxV2Pipe;
+  id<MTLComputePipelineState> avc444ToBgraPipe;
+  id<MTLComputePipelineState> copyOpaquePipe;
+  id<MTLComputePipelineState> clearCodecPipe;
+  id<MTLComputePipelineState> solidFillPipe;
+  id<MTLComputePipelineState> blitScaledPipe;
+  NSMutableDictionary<NSNumber*, PagaMetalSurface*>* surfaces;
+  NSMutableArray<NSNumber*>* mapOrder;
+  NSMutableDictionary<NSNumber*, PagaMetalCacheEntry*>* cache;
+  size_t budgetUsed;
+  uint16_t outputWidth;
+  uint16_t outputHeight;
+  CVPixelBufferPoolRef outputPool;
+  id<MTLCommandBuffer> pendingCmd;
+  BOOL dirty;
+}
+@end
+
+@implementation PagaMetalState
+- (void)dealloc {
+  if (pendingCmd) {
+    [pendingCmd commit];
+    [pendingCmd waitUntilCompleted];
+    pendingCmd = nil;
+  }
+  if (outputPool) {
+    CVPixelBufferPoolRelease(outputPool);
+    outputPool = NULL;
+  }
+  if (textureCache) {
+    CFRelease(textureCache);
+    textureCache = NULL;
+  }
+}
+@end
+
+typedef struct {
+  uint32_t src_x, src_y, dst_x, dst_y, width, height;
+} Avc420Params;
+
+typedef struct {
+  uint32_t area_left, area_top, area_width, area_height;
+  uint32_t rect_left, rect_top, rect_right, rect_bottom;
+} Avc444MainParams;
+
+typedef struct {
+  uint32_t area_left, area_top, area_width, area_height;
+  uint32_t half_w, quarter_w;
+} Avc444AuxParams;
+
+typedef struct {
+  uint32_t x, y, width, height;
+} RectParams;
+
+typedef struct {
+  uint32_t x, y, width, height;
+  float r, g, b;
+} SolidFillParams;
+
+typedef struct {
+  uint32_t dst_x, dst_y, dst_w, dst_h, src_w, src_h;
+} BlitScaledParams;
+
+static id<MTLComputePipelineState> make_pipeline(id<MTLDevice> device, id<MTLLibrary> lib,
+                                                 NSString* name) {
+  id<MTLFunction> fn = [lib newFunctionWithName:name];
+  if (!fn) return nil;
+  NSError* err = nil;
+  return [device newComputePipelineStateWithFunction:fn error:&err];
+}
+
+static void dispatch_2d(id<MTLComputeCommandEncoder> enc, id<MTLComputePipelineState> pipe,
+                        uint32_t width, uint32_t height) {
+  if (width == 0 || height == 0) return;
+  MTLSize tg = MTLSizeMake(16, 16, 1);
+  MTLSize grid = MTLSizeMake((width + 15u) / 16u, (height + 15u) / 16u, 1);
+  [enc setComputePipelineState:pipe];
+  [enc dispatchThreadgroups:grid threadsPerThreadgroup:tg];
+}
+
+static id<MTLCommandBuffer> ensure_cmd(PagaMetalState* s) {
+  if (!s->pendingCmd) {
+    s->pendingCmd = [s->queue commandBuffer];
+  }
+  return s->pendingCmd;
+}
+
+static id<MTLTexture> make_texture(id<MTLDevice> device, MTLPixelFormat fmt,
+                                   uint32_t width, uint32_t height, MTLTextureUsage usage,
+                                   MTLStorageMode storage) {
+  MTLTextureDescriptor* desc =
+      [MTLTextureDescriptor texture2DDescriptorWithPixelFormat:fmt
+                                                         width:width
+                                                        height:height
+                                                     mipmapped:NO];
+  desc.usage = usage;
+  desc.storageMode = storage;
+  return [device newTextureWithDescriptor:desc];
+}
+
+static bool fill_texture_solid(PagaMetalState* s, id<MTLTexture> tex,
+                               uint32_t x, uint32_t y, uint32_t w, uint32_t h,
+                               float r, float g, float b) {
+  id<MTLCommandBuffer> cmd = ensure_cmd(s);
+  if (!cmd) return false;
+  id<MTLComputeCommandEncoder> enc = [cmd computeCommandEncoder];
+  if (!enc) return false;
+  SolidFillParams p = {x, y, w, h, r, g, b};
+  [enc setTexture:tex atIndex:0];
+  [enc setBytes:&p length:sizeof(p) atIndex:0];
+  dispatch_2d(enc, s->solidFillPipe, w, h);
+  [enc endEncoding];
+  return true;
+}
+
+static bool wrap_nv12(PagaMetalState* s, CVPixelBufferRef pb,
+                      CVMetalTextureRef* out_y, CVMetalTextureRef* out_uv) {
+  *out_y = NULL;
+  *out_uv = NULL;
+  if (!pb || CVPixelBufferGetPlaneCount(pb) != 2) return false;
+  size_t y_w = CVPixelBufferGetWidthOfPlane(pb, 0);
+  size_t y_h = CVPixelBufferGetHeightOfPlane(pb, 0);
+  size_t uv_w = CVPixelBufferGetWidthOfPlane(pb, 1);
+  size_t uv_h = CVPixelBufferGetHeightOfPlane(pb, 1);
+  if (!y_w || !y_h || !uv_w || !uv_h) return false;
+  CVReturn r1 = CVMetalTextureCacheCreateTextureFromImage(
+      kCFAllocatorDefault, s->textureCache, pb, NULL, MTLPixelFormatR8Unorm, y_w, y_h, 0, out_y);
+  CVReturn r2 = CVMetalTextureCacheCreateTextureFromImage(
+      kCFAllocatorDefault, s->textureCache, pb, NULL, MTLPixelFormatRG8Unorm, uv_w, uv_h, 1, out_uv);
+  if (r1 != kCVReturnSuccess || r2 != kCVReturnSuccess || !*out_y || !*out_uv) {
+    if (*out_y) CFRelease(*out_y);
+    if (*out_uv) CFRelease(*out_uv);
+    *out_y = NULL;
+    *out_uv = NULL;
+    return false;
+  }
+  return true;
+}
+
+static bool ensure_avc444_planes(PagaMetalState* s, PagaMetalSurface* surf) {
+  if (surf.avcY && surf.avcU && surf.avcV) return true;
+  uint32_t pw = ((uint32_t)surf.width + 15u) & ~15u;
+  uint32_t ph = ((uint32_t)surf.height + 15u) & ~15u;
+  size_t extra = (size_t)pw * (size_t)ph * 3u;
+  if (s->budgetUsed + extra > kMaxBudgetBytes) return false;
+  MTLTextureUsage usage = MTLTextureUsageShaderRead | MTLTextureUsageShaderWrite;
+  id<MTLTexture> y = make_texture(s->device, MTLPixelFormatR8Unorm, pw, ph, usage, MTLStorageModePrivate);
+  id<MTLTexture> u = make_texture(s->device, MTLPixelFormatR8Unorm, pw, ph, usage, MTLStorageModePrivate);
+  id<MTLTexture> v = make_texture(s->device, MTLPixelFormatR8Unorm, pw, ph, usage, MTLStorageModePrivate);
+  if (!y || !u || !v) return false;
+  // Initialize Y=0, U=128/255, V=128/255.
+  if (!fill_texture_solid(s, y, 0, 0, pw, ph, 0.0f, 0.0f, 0.0f) ||
+      !fill_texture_solid(s, u, 0, 0, pw, ph, 128.0f / 255.0f, 0.0f, 0.0f) ||
+      !fill_texture_solid(s, v, 0, 0, pw, ph, 128.0f / 255.0f, 0.0f, 0.0f)) {
+    return false;
+  }
+  surf.avcY = y;
+  surf.avcU = u;
+  surf.avcV = v;
+  surf.bytes += extra;
+  s->budgetUsed += extra;
+  return true;
+}
+
+static void mark_painted(PagaMetalState* s, PagaMetalSurface* surf) {
+  surf.painted = YES;
+  if (surf.mapped) s->dirty = YES;
+}
+
+void* paga_metal_compositor_new(void) {
+  @autoreleasepool {
+    id<MTLDevice> device = MTLCreateSystemDefaultDevice();
+    if (!device) return NULL;
+    id<MTLCommandQueue> queue = [device newCommandQueue];
+    if (!queue) return NULL;
+    CVMetalTextureCacheRef cache = NULL;
+    if (CVMetalTextureCacheCreate(kCFAllocatorDefault, NULL, device, NULL, &cache) !=
+            kCVReturnSuccess ||
+        !cache) {
+      return NULL;
+    }
+    NSError* err = nil;
+    id<MTLLibrary> lib = [device newLibraryWithSource:kMetalShaderSource options:nil error:&err];
+    if (!lib) {
+      CFRelease(cache);
+      return NULL;
+    }
+    PagaMetalState* s = [[PagaMetalState alloc] init];
+    s->device = device;
+    s->queue = queue;
+    s->textureCache = cache;
+    s->avc420Pipe = make_pipeline(device, lib, @"avc420_to_bgra");
+    s->avc444MainPipe = make_pipeline(device, lib, @"avc444_apply_main");
+    s->avc444AuxV1Pipe = make_pipeline(device, lib, @"avc444_apply_aux_v1");
+    s->avc444AuxV2Pipe = make_pipeline(device, lib, @"avc444_apply_aux_v2");
+    s->avc444ToBgraPipe = make_pipeline(device, lib, @"avc444_to_bgra");
+    s->copyOpaquePipe = make_pipeline(device, lib, @"copy_opaque");
+    s->clearCodecPipe = make_pipeline(device, lib, @"clearcodec_composite");
+    s->solidFillPipe = make_pipeline(device, lib, @"solid_fill");
+    s->blitScaledPipe = make_pipeline(device, lib, @"blit_scaled");
+    if (!s->avc420Pipe || !s->avc444MainPipe || !s->avc444AuxV1Pipe ||
+        !s->avc444AuxV2Pipe || !s->avc444ToBgraPipe || !s->copyOpaquePipe ||
+        !s->clearCodecPipe || !s->solidFillPipe || !s->blitScaledPipe) {
+      return NULL;
+    }
+    s->surfaces = [NSMutableDictionary dictionary];
+    s->mapOrder = [NSMutableArray array];
+    s->cache = [NSMutableDictionary dictionary];
+    s->budgetUsed = 0;
+    s->outputWidth = 0;
+    s->outputHeight = 0;
+    s->outputPool = NULL;
+    s->pendingCmd = nil;
+    s->dirty = NO;
+    return (void*)CFBridgingRetain(s);
+  }
+}
+
+void paga_metal_compositor_free(void* handle) {
+  if (!handle) return;
+  @autoreleasepool {
+    PagaMetalState* s = (__bridge_transfer PagaMetalState*)handle;
+    (void)s;
+  }
+}
+
+bool paga_metal_compositor_reset(void* handle, uint32_t width, uint32_t height) {
+  if (!handle || width == 0 || height == 0 || width > UINT16_MAX || height > UINT16_MAX ||
+      (uint64_t)width * (uint64_t)height > kMaxOutputPixels) {
+    return false;
+  }
+  @autoreleasepool {
+    PagaMetalState* s = (__bridge PagaMetalState*)handle;
+    if (s->pendingCmd) {
+      [s->pendingCmd commit];
+      [s->pendingCmd waitUntilCompleted];
+      s->pendingCmd = nil;
+    }
+    for (PagaMetalSurface* surf in [s->surfaces allValues]) {
+      if (s->budgetUsed >= surf.bytes) s->budgetUsed -= surf.bytes;
+    }
+    [s->surfaces removeAllObjects];
+    [s->mapOrder removeAllObjects];
+    s->dirty = NO;
+    if (s->outputWidth != (uint16_t)width || s->outputHeight != (uint16_t)height || !s->outputPool) {
+      if (s->outputPool) {
+        CVPixelBufferPoolRelease(s->outputPool);
+        s->outputPool = NULL;
+      }
+      NSDictionary* attrs = @{
+        (id)kCVPixelBufferPixelFormatTypeKey : @(kCVPixelFormatType_32BGRA),
+        (id)kCVPixelBufferWidthKey : @(width),
+        (id)kCVPixelBufferHeightKey : @(height),
+        (id)kCVPixelBufferIOSurfacePropertiesKey : @{},
+        (id)kCVPixelBufferMetalCompatibilityKey : @YES,
+      };
+      if (CVPixelBufferPoolCreate(kCFAllocatorDefault, NULL, (__bridge CFDictionaryRef)attrs,
+                                  &s->outputPool) != kCVReturnSuccess ||
+          !s->outputPool) {
+        s->outputWidth = 0;
+        s->outputHeight = 0;
+        return false;
+      }
+      s->outputWidth = (uint16_t)width;
+      s->outputHeight = (uint16_t)height;
+    }
+    return true;
+  }
+}
+
+bool paga_metal_compositor_create_surface(void* handle, uint16_t surface_id, uint16_t width, uint16_t height) {
+  if (!handle || width == 0 || height == 0) return false;
+  @autoreleasepool {
+    PagaMetalState* s = (__bridge PagaMetalState*)handle;
+    NSNumber* key = @(surface_id);
+    PagaMetalSurface* existing = s->surfaces[key];
+    if (existing) {
+      if (s->budgetUsed >= existing.bytes) s->budgetUsed -= existing.bytes;
+      [s->surfaces removeObjectForKey:key];
+      [s->mapOrder removeObject:key];
+    }
+    size_t bytes = (size_t)width * (size_t)height * 4u;
+    if (s->budgetUsed + bytes > kMaxBudgetBytes) return false;
+    MTLTextureUsage usage = MTLTextureUsageShaderRead | MTLTextureUsageShaderWrite;
+    id<MTLTexture> tex =
+        make_texture(s->device, MTLPixelFormatBGRA8Unorm, width, height, usage, MTLStorageModePrivate);
+    if (!tex) return false;
+    if (!fill_texture_solid(s, tex, 0, 0, width, height, 0.0f, 0.0f, 0.0f)) return false;
+    PagaMetalSurface* surf = [[PagaMetalSurface alloc] init];
+    surf.surfaceId = surface_id;
+    surf.width = width;
+    surf.height = height;
+    surf.color = tex;
+    surf.bytes = bytes;
+    surf.mapped = NO;
+    surf.painted = NO;
+    s->surfaces[key] = surf;
+    s->budgetUsed += bytes;
+    return true;
+  }
+}
+
+void paga_metal_compositor_delete_surface(void* handle, uint16_t surface_id) {
+  if (!handle) return;
+  @autoreleasepool {
+    PagaMetalState* s = (__bridge PagaMetalState*)handle;
+    NSNumber* key = @(surface_id);
+    PagaMetalSurface* surf = s->surfaces[key];
+    if (surf) {
+      if (surf.mapped && surf.painted) s->dirty = YES;
+      if (s->budgetUsed >= surf.bytes) s->budgetUsed -= surf.bytes;
+      [s->surfaces removeObjectForKey:key];
+      [s->mapOrder removeObject:key];
+    }
+  }
+}
+
+bool paga_metal_compositor_map_surface(void* handle, uint16_t surface_id, uint32_t origin_x,
+                                       uint32_t origin_y, uint32_t target_w, uint32_t target_h) {
+  if (!handle) return false;
+  @autoreleasepool {
+    PagaMetalState* s = (__bridge PagaMetalState*)handle;
+    NSNumber* key = @(surface_id);
+    PagaMetalSurface* surf = s->surfaces[key];
+    if (!surf) return false;
+    surf.mapped = YES;
+    surf.originX = origin_x;
+    surf.originY = origin_y;
+    surf.targetW = target_w ? target_w : surf.width;
+    surf.targetH = target_h ? target_h : surf.height;
+    [s->mapOrder removeObject:key];
+    [s->mapOrder addObject:key];
+    if (surf.painted) s->dirty = YES;
+    return true;
+  }
+}
+
+void paga_metal_compositor_unmap_surface(void* handle, uint16_t surface_id) {
+  if (!handle) return;
+  @autoreleasepool {
+    PagaMetalState* s = (__bridge PagaMetalState*)handle;
+    NSNumber* key = @(surface_id);
+    PagaMetalSurface* surf = s->surfaces[key];
+    if (surf && surf.mapped) {
+      surf.mapped = NO;
+      [s->mapOrder removeObject:key];
+      if (surf.painted) s->dirty = YES;
+    }
+  }
+}
+
+bool paga_metal_compositor_apply_avc420(void* handle, uint16_t surface_id, CVPixelBufferRef pb,
+                                        PagaMetalRect dest, const PagaMetalRect* rects,
+                                        size_t rect_count) {
+  if (!handle || !pb) return false;
+  @autoreleasepool {
+    PagaMetalState* s = (__bridge PagaMetalState*)handle;
+    PagaMetalSurface* surf = s->surfaces[@(surface_id)];
+    if (!surf) return false;
+    CVMetalTextureRef yRef = NULL, uvRef = NULL;
+    if (!wrap_nv12(s, pb, &yRef, &uvRef)) return false;
+    id<MTLTexture> yTex = CVMetalTextureGetTexture(yRef);
+    id<MTLTexture> uvTex = CVMetalTextureGetTexture(uvRef);
+    id<MTLCommandBuffer> cmd = ensure_cmd(s);
+    id<MTLComputeCommandEncoder> enc = cmd ? [cmd computeCommandEncoder] : nil;
+    bool ok = false;
+    if (yTex && uvTex && enc) {
+      [enc setTexture:yTex atIndex:0];
+      [enc setTexture:uvTex atIndex:1];
+      [enc setTexture:surf.color atIndex:2];
+      if (rect_count == 0) {
+        if (dest.left < dest.right && dest.top < dest.bottom) {
+          uint32_t w = dest.right - dest.left;
+          uint32_t h = dest.bottom - dest.top;
+          Avc420Params p = {0, 0, dest.left, dest.top, w, h};
+          [enc setBytes:&p length:sizeof(p) atIndex:0];
+          dispatch_2d(enc, s->avc420Pipe, w, h);
+        }
+      } else {
+        for (size_t i = 0; i < rect_count; ++i) {
+          PagaMetalRect r = rects[i];
+          if (r.left >= r.right || r.top >= r.bottom) continue;
+          uint32_t w = r.right - r.left;
+          uint32_t h = r.bottom - r.top;
+          Avc420Params p = {r.left, r.top, r.left, r.top, w, h};
+          [enc setBytes:&p length:sizeof(p) atIndex:0];
+          dispatch_2d(enc, s->avc420Pipe, w, h);
+        }
+      }
+      [enc endEncoding];
+      // Keep the VideoToolbox IOSurface alive until the command buffer finishes.
+      CVPixelBufferRef retainedPb = CVPixelBufferRetain(pb);
+      CVMetalTextureRef retainedY = (CVMetalTextureRef)CFRetain(yRef);
+      CVMetalTextureRef retainedUv = (CVMetalTextureRef)CFRetain(uvRef);
+      [cmd addCompletedHandler:^(id<MTLCommandBuffer> _Nonnull _cb) {
+        (void)_cb;
+        CFRelease(retainedUv);
+        CFRelease(retainedY);
+        CVPixelBufferRelease(retainedPb);
+      }];
+      mark_painted(s, surf);
+      ok = true;
+    }
+    CFRelease(uvRef);
+    CFRelease(yRef);
+    return ok;
+  }
+}
+
+bool paga_metal_compositor_apply_avc444(void* handle, uint16_t surface_id, bool is_v2,
+                                        CVPixelBufferRef main_pb, const PagaMetalRect* main_rects,
+                                        size_t main_count, CVPixelBufferRef aux_pb,
+                                        const PagaMetalRect* aux_rects, size_t aux_count,
+                                        const PagaMetalRect* painted, size_t painted_count) {
+  if (!handle) return false;
+  @autoreleasepool {
+    PagaMetalState* s = (__bridge PagaMetalState*)handle;
+    PagaMetalSurface* surf = s->surfaces[@(surface_id)];
+    if (!surf) return false;
+    if (!main_pb && (!surf.avcY || !surf.avcU || !surf.avcV)) {
+      // Chroma-only update before any luma picture: ignore safely.
+      return true;
+    }
+    if (!ensure_avc444_planes(s, surf)) return false;
+
+    id<MTLCommandBuffer> cmd = ensure_cmd(s);
+    if (!cmd) return false;
+
+    if (main_pb && main_count > 0) {
+      CVMetalTextureRef yRef = NULL, uvRef = NULL;
+      if (!wrap_nv12(s, main_pb, &yRef, &uvRef)) return false;
+      id<MTLTexture> yTex = CVMetalTextureGetTexture(yRef);
+      id<MTLTexture> uvTex = CVMetalTextureGetTexture(uvRef);
+      id<MTLComputeCommandEncoder> enc = [cmd computeCommandEncoder];
+      if (!yTex || !uvTex || !enc) {
+        CFRelease(uvRef);
+        CFRelease(yRef);
+        return false;
+      }
+      [enc setTexture:yTex atIndex:0];
+      [enc setTexture:uvTex atIndex:1];
+      [enc setTexture:surf.avcY atIndex:2];
+      [enc setTexture:surf.avcU atIndex:3];
+      [enc setTexture:surf.avcV atIndex:4];
+      for (size_t i = 0; i < main_count; ++i) {
+        PagaMetalRect r = main_rects[i];
+        uint32_t left = (uint32_t)r.left & ~1u;
+        uint32_t top = (uint32_t)r.top & ~1u;
+        uint32_t right = (((uint32_t)(r.right < surf.width ? r.right : surf.width) + 1u) & ~1u);
+        uint32_t bottom = (((uint32_t)(r.bottom < surf.height ? r.bottom : surf.height) + 1u) & ~1u);
+        if (left >= right || top >= bottom) continue;
+        Avc444MainParams p = {
+            left,
+            top,
+            right - left,
+            bottom - top,
+            r.left,
+            r.top,
+            r.right < surf.width ? r.right : surf.width,
+            r.bottom < surf.height ? r.bottom : surf.height,
+        };
+        [enc setBytes:&p length:sizeof(p) atIndex:0];
+        dispatch_2d(enc, s->avc444MainPipe, p.area_width, p.area_height);
+      }
+      [enc endEncoding];
+      CVPixelBufferRef retainedPb = CVPixelBufferRetain(main_pb);
+      CVMetalTextureRef retainedY = (CVMetalTextureRef)CFRetain(yRef);
+      CVMetalTextureRef retainedUv = (CVMetalTextureRef)CFRetain(uvRef);
+      [cmd addCompletedHandler:^(id<MTLCommandBuffer> _Nonnull _cb) {
+        (void)_cb;
+        CFRelease(retainedUv);
+        CFRelease(retainedY);
+        CVPixelBufferRelease(retainedPb);
+      }];
+      CFRelease(uvRef);
+      CFRelease(yRef);
+    }
+
+    if (aux_pb && aux_count > 0) {
+      CVMetalTextureRef yRef = NULL, uvRef = NULL;
+      if (!wrap_nv12(s, aux_pb, &yRef, &uvRef)) return false;
+      id<MTLTexture> yTex = CVMetalTextureGetTexture(yRef);
+      id<MTLTexture> uvTex = CVMetalTextureGetTexture(uvRef);
+      id<MTLComputeCommandEncoder> enc = [cmd computeCommandEncoder];
+      if (!yTex || !uvTex || !enc) {
+        CFRelease(uvRef);
+        CFRelease(yRef);
+        return false;
+      }
+      uint32_t padded_w = (((uint32_t)CVPixelBufferGetWidth(aux_pb) + 15u) & ~15u);
+      uint32_t half_w = padded_w >> 1;
+      uint32_t quarter_w = half_w >> 1;
+      [enc setTexture:yTex atIndex:0];
+      [enc setTexture:uvTex atIndex:1];
+      [enc setTexture:surf.avcU atIndex:2];
+      [enc setTexture:surf.avcV atIndex:3];
+      id<MTLComputePipelineState> pipe = is_v2 ? s->avc444AuxV2Pipe : s->avc444AuxV1Pipe;
+      for (size_t i = 0; i < aux_count; ++i) {
+        PagaMetalRect r = aux_rects[i];
+        uint32_t left = (uint32_t)r.left & ~1u;
+        uint32_t top = (uint32_t)r.top & ~1u;
+        uint32_t right = (((uint32_t)(r.right < surf.width ? r.right : surf.width) + 1u) & ~1u);
+        uint32_t bottom = (((uint32_t)(r.bottom < surf.height ? r.bottom : surf.height) + 1u) & ~1u);
+        if (left >= right || top >= bottom) continue;
+        Avc444AuxParams p = {left, top, right - left, bottom - top, half_w, quarter_w};
+        [enc setBytes:&p length:sizeof(p) atIndex:0];
+        dispatch_2d(enc, pipe, p.area_width, p.area_height);
+      }
+      [enc endEncoding];
+      CVPixelBufferRef retainedPb = CVPixelBufferRetain(aux_pb);
+      CVMetalTextureRef retainedY = (CVMetalTextureRef)CFRetain(yRef);
+      CVMetalTextureRef retainedUv = (CVMetalTextureRef)CFRetain(uvRef);
+      [cmd addCompletedHandler:^(id<MTLCommandBuffer> _Nonnull _cb) {
+        (void)_cb;
+        CFRelease(retainedUv);
+        CFRelease(retainedY);
+        CVPixelBufferRelease(retainedPb);
+      }];
+      CFRelease(uvRef);
+      CFRelease(yRef);
+    }
+
+    if (painted_count > 0) {
+      id<MTLComputeCommandEncoder> enc = [cmd computeCommandEncoder];
+      if (!enc) return false;
+      [enc setTexture:surf.avcY atIndex:0];
+      [enc setTexture:surf.avcU atIndex:1];
+      [enc setTexture:surf.avcV atIndex:2];
+      [enc setTexture:surf.color atIndex:3];
+      for (size_t i = 0; i < painted_count; ++i) {
+        PagaMetalRect r = painted[i];
+        uint32_t right = r.right < surf.width ? r.right : surf.width;
+        uint32_t bottom = r.bottom < surf.height ? r.bottom : surf.height;
+        if (r.left >= right || r.top >= bottom) continue;
+        RectParams p = {r.left, r.top, right - r.left, bottom - r.top};
+        [enc setBytes:&p length:sizeof(p) atIndex:0];
+        dispatch_2d(enc, s->avc444ToBgraPipe, p.width, p.height);
+      }
+      [enc endEncoding];
+      mark_painted(s, surf);
+    }
+    return true;
+  }
+}
+
+static bool upload_patch_with_pipe(PagaMetalState* s, PagaMetalSurface* surf, PagaMetalRect dest,
+                                   const uint8_t* pixels, size_t pitch, uint16_t src_x,
+                                   uint16_t src_y, MTLPixelFormat src_fmt,
+                                   id<MTLComputePipelineState> pipe) {
+  uint32_t right = dest.right < surf.width ? dest.right : surf.width;
+  uint32_t bottom = dest.bottom < surf.height ? dest.bottom : surf.height;
+  if (dest.left >= right || dest.top >= bottom) return true;
+  uint32_t w = right - dest.left;
+  uint32_t h = bottom - dest.top;
+  id<MTLTexture> staging = make_texture(s->device, src_fmt, w, h, MTLTextureUsageShaderRead,
+                                        MTLStorageModeShared);
+  if (!staging) return false;
+  const uint8_t* origin = pixels + (size_t)src_y * pitch + (size_t)src_x * 4u;
+  [staging replaceRegion:MTLRegionMake2D(0, 0, w, h)
+             mipmapLevel:0
+               withBytes:origin
+             bytesPerRow:pitch];
+  id<MTLCommandBuffer> cmd = ensure_cmd(s);
+  if (!cmd) return false;
+  id<MTLComputeCommandEncoder> enc = [cmd computeCommandEncoder];
+  if (!enc) return false;
+  RectParams p = {dest.left, dest.top, w, h};
+  [enc setTexture:staging atIndex:0];
+  [enc setTexture:surf.color atIndex:1];
+  [enc setBytes:&p length:sizeof(p) atIndex:0];
+  dispatch_2d(enc, pipe, w, h);
+  [enc endEncoding];
+  mark_painted(s, surf);
+  return true;
+}
+
+bool paga_metal_compositor_apply_rgba(void* handle, uint16_t surface_id, PagaMetalRect dest,
+                                      const uint8_t* rgba, size_t pitch, uint16_t src_x,
+                                      uint16_t src_y) {
+  if (!handle || !rgba) return false;
+  @autoreleasepool {
+    PagaMetalState* s = (__bridge PagaMetalState*)handle;
+    PagaMetalSurface* surf = s->surfaces[@(surface_id)];
+    if (!surf) return false;
+    return upload_patch_with_pipe(s, surf, dest, rgba, pitch, src_x, src_y,
+                                  MTLPixelFormatRGBA8Unorm, s->copyOpaquePipe);
+  }
+}
+
+bool paga_metal_compositor_apply_clearcodec(void* handle, uint16_t surface_id, PagaMetalRect dest,
+                                            const uint8_t* bgra_coverage) {
+  if (!handle || !bgra_coverage) return false;
+  @autoreleasepool {
+    PagaMetalState* s = (__bridge PagaMetalState*)handle;
+    PagaMetalSurface* surf = s->surfaces[@(surface_id)];
+    if (!surf) return false;
+    if (dest.left >= dest.right || dest.top >= dest.bottom) return true;
+    size_t pitch = (size_t)(dest.right - dest.left) * 4u;
+    return upload_patch_with_pipe(s, surf, dest, bgra_coverage, pitch, 0, 0,
+                                  MTLPixelFormatBGRA8Unorm, s->clearCodecPipe);
+  }
+}
+
+bool paga_metal_compositor_solid_fill(void* handle, uint16_t surface_id, uint8_t r, uint8_t g, uint8_t b,
+                                      const PagaMetalRect* rects, size_t rect_count) {
+  if (!handle) return false;
+  @autoreleasepool {
+    PagaMetalState* s = (__bridge PagaMetalState*)handle;
+    PagaMetalSurface* surf = s->surfaces[@(surface_id)];
+    if (!surf) return false;
+    float rf = (float)r / 255.0f;
+    float gf = (float)g / 255.0f;
+    float bf = (float)b / 255.0f;
+    for (size_t i = 0; i < rect_count; ++i) {
+      PagaMetalRect rect = rects[i];
+      uint32_t right = rect.right < surf.width ? rect.right : surf.width;
+      uint32_t bottom = rect.bottom < surf.height ? rect.bottom : surf.height;
+      if (rect.left >= right || rect.top >= bottom) continue;
+      if (!fill_texture_solid(s, surf.color, rect.left, rect.top, right - rect.left,
+                              bottom - rect.top, rf, gf, bf)) {
+        return false;
+      }
+      mark_painted(s, surf);
+    }
+    return true;
+  }
+}
+
+bool paga_metal_compositor_surface_to_surface(void* handle, uint16_t src_id, uint16_t dst_id,
+                                              PagaMetalRect src_rect, const PagaMetalPoint* dsts,
+                                              size_t dst_count) {
+  if (!handle) return false;
+  @autoreleasepool {
+    PagaMetalState* s = (__bridge PagaMetalState*)handle;
+    PagaMetalSurface* src = s->surfaces[@(src_id)];
+    PagaMetalSurface* dst = s->surfaces[@(dst_id)];
+    if (!src || !dst) return false;
+    uint32_t sr = src_rect.right < src.width ? src_rect.right : src.width;
+    uint32_t sb = src_rect.bottom < src.height ? src_rect.bottom : src.height;
+    if (src_rect.left >= sr || src_rect.top >= sb || dst_count == 0) return true;
+    uint32_t w = sr - src_rect.left;
+    uint32_t h = sb - src_rect.top;
+    id<MTLCommandBuffer> cmd = ensure_cmd(s);
+    if (!cmd) return false;
+    id<MTLBlitCommandEncoder> blit = [cmd blitCommandEncoder];
+    if (!blit) return false;
+
+    id<MTLTexture> copySrc = src.color;
+    uint32_t copySrcX = src_rect.left;
+    uint32_t copySrcY = src_rect.top;
+    if (src_id == dst_id) {
+      id<MTLTexture> scratch =
+          make_texture(s->device, MTLPixelFormatBGRA8Unorm, w, h,
+                       MTLTextureUsageShaderRead | MTLTextureUsageShaderWrite, MTLStorageModePrivate);
+      if (!scratch) {
+        [blit endEncoding];
+        return false;
+      }
+      [blit copyFromTexture:src.color
+                sourceSlice:0
+                sourceLevel:0
+               sourceOrigin:MTLOriginMake(src_rect.left, src_rect.top, 0)
+                 sourceSize:MTLSizeMake(w, h, 1)
+                  toTexture:scratch
+           destinationSlice:0
+           destinationLevel:0
+          destinationOrigin:MTLOriginMake(0, 0, 0)];
+      copySrc = scratch;
+      copySrcX = 0;
+      copySrcY = 0;
+    }
+    for (size_t i = 0; i < dst_count; ++i) {
+      uint32_t dx = dsts[i].x;
+      uint32_t dy = dsts[i].y;
+      if (dx >= dst.width || dy >= dst.height) continue;
+      uint32_t cw = w < (dst.width - dx) ? w : (dst.width - dx);
+      uint32_t ch = h < (dst.height - dy) ? h : (dst.height - dy);
+      if (cw == 0 || ch == 0) continue;
+      [blit copyFromTexture:copySrc
+                sourceSlice:0
+                sourceLevel:0
+               sourceOrigin:MTLOriginMake(copySrcX, copySrcY, 0)
+                 sourceSize:MTLSizeMake(cw, ch, 1)
+                  toTexture:dst.color
+           destinationSlice:0
+           destinationLevel:0
+          destinationOrigin:MTLOriginMake(dx, dy, 0)];
+    }
+    [blit endEncoding];
+    mark_painted(s, dst);
+    return true;
+  }
+}
+
+bool paga_metal_compositor_surface_to_cache(void* handle, uint16_t surface_id, uint16_t slot,
+                                            PagaMetalRect src_rect) {
+  if (!handle) return false;
+  @autoreleasepool {
+    PagaMetalState* s = (__bridge PagaMetalState*)handle;
+    PagaMetalSurface* src = s->surfaces[@(surface_id)];
+    if (!src) return false;
+    uint32_t sr = src_rect.right < src.width ? src_rect.right : src.width;
+    uint32_t sb = src_rect.bottom < src.height ? src_rect.bottom : src.height;
+    if (src_rect.left >= sr || src_rect.top >= sb) return false;
+    uint32_t w = sr - src_rect.left;
+    uint32_t h = sb - src_rect.top;
+    NSNumber* key = @(slot);
+    PagaMetalCacheEntry* prev = s->cache[key];
+    if (prev) {
+      if (s->budgetUsed >= prev.bytes) s->budgetUsed -= prev.bytes;
+      [s->cache removeObjectForKey:key];
+    }
+    size_t bytes = (size_t)w * (size_t)h * 4u;
+    if (s->budgetUsed + bytes > kMaxBudgetBytes) return false;
+    id<MTLTexture> tex =
+        make_texture(s->device, MTLPixelFormatBGRA8Unorm, w, h, MTLTextureUsageShaderRead,
+                     MTLStorageModePrivate);
+    if (!tex) return false;
+    id<MTLCommandBuffer> cmd = ensure_cmd(s);
+    if (!cmd) return false;
+    id<MTLBlitCommandEncoder> blit = [cmd blitCommandEncoder];
+    if (!blit) return false;
+    [blit copyFromTexture:src.color
+              sourceSlice:0
+              sourceLevel:0
+             sourceOrigin:MTLOriginMake(src_rect.left, src_rect.top, 0)
+               sourceSize:MTLSizeMake(w, h, 1)
+                toTexture:tex
+         destinationSlice:0
+         destinationLevel:0
+        destinationOrigin:MTLOriginMake(0, 0, 0)];
+    [blit endEncoding];
+    PagaMetalCacheEntry* entry = [[PagaMetalCacheEntry alloc] init];
+    entry.width = (uint16_t)w;
+    entry.height = (uint16_t)h;
+    entry.texture = tex;
+    entry.bytes = bytes;
+    s->cache[key] = entry;
+    s->budgetUsed += bytes;
+    return true;
+  }
+}
+
+bool paga_metal_compositor_cache_to_surface(void* handle, uint16_t slot, uint16_t surface_id,
+                                            const PagaMetalPoint* dsts, size_t dst_count) {
+  if (!handle) return false;
+  @autoreleasepool {
+    PagaMetalState* s = (__bridge PagaMetalState*)handle;
+    PagaMetalCacheEntry* entry = s->cache[@(slot)];
+    PagaMetalSurface* dst = s->surfaces[@(surface_id)];
+    if (!entry || !dst) return false;
+    if (dst_count == 0) return true;
+    id<MTLCommandBuffer> cmd = ensure_cmd(s);
+    if (!cmd) return false;
+    id<MTLBlitCommandEncoder> blit = [cmd blitCommandEncoder];
+    if (!blit) return false;
+    for (size_t i = 0; i < dst_count; ++i) {
+      uint32_t dx = dsts[i].x;
+      uint32_t dy = dsts[i].y;
+      if (dx >= dst.width || dy >= dst.height) continue;
+      uint32_t cw = entry.width < (dst.width - dx) ? entry.width : (dst.width - dx);
+      uint32_t ch = entry.height < (dst.height - dy) ? entry.height : (dst.height - dy);
+      if (cw == 0 || ch == 0) continue;
+      [blit copyFromTexture:entry.texture
+                sourceSlice:0
+                sourceLevel:0
+               sourceOrigin:MTLOriginMake(0, 0, 0)
+                 sourceSize:MTLSizeMake(cw, ch, 1)
+                  toTexture:dst.color
+           destinationSlice:0
+           destinationLevel:0
+          destinationOrigin:MTLOriginMake(dx, dy, 0)];
+    }
+    [blit endEncoding];
+    mark_painted(s, dst);
+    return true;
+  }
+}
+
+void paga_metal_compositor_evict_cache(void* handle, uint16_t slot) {
+  if (!handle) return;
+  @autoreleasepool {
+    PagaMetalState* s = (__bridge PagaMetalState*)handle;
+    NSNumber* key = @(slot);
+    PagaMetalCacheEntry* entry = s->cache[key];
+    if (entry) {
+      if (s->budgetUsed >= entry.bytes) s->budgetUsed -= entry.bytes;
+      [s->cache removeObjectForKey:key];
+    }
+  }
+}
+
+CVPixelBufferRef paga_metal_compositor_end_frame(void* handle, uint16_t* out_width,
+                                                 uint16_t* out_height) {
+  if (!handle) return NULL;
+  @autoreleasepool {
+    PagaMetalState* s = (__bridge PagaMetalState*)handle;
+    if (!s->dirty || !s->outputPool || s->outputWidth == 0 || s->outputHeight == 0) {
+      if (s->pendingCmd) {
+        [s->pendingCmd commit];
+        [s->pendingCmd waitUntilCompleted];
+        s->pendingCmd = nil;
+      }
+      return NULL;
+    }
+    NSDictionary* aux = @{(id)kCVPixelBufferPoolAllocationThresholdKey : @(5)};
+    CVPixelBufferRef pb = NULL;
+    if (CVPixelBufferPoolCreatePixelBufferWithAuxAttributes(
+            kCFAllocatorDefault, s->outputPool, (__bridge CFDictionaryRef)aux, &pb) !=
+            kCVReturnSuccess ||
+        !pb) {
+      return NULL;
+    }
+    CVMetalTextureRef outTexRef = NULL;
+    if (CVMetalTextureCacheCreateTextureFromImage(
+            kCFAllocatorDefault, s->textureCache, pb, NULL, MTLPixelFormatBGRA8Unorm,
+            s->outputWidth, s->outputHeight, 0, &outTexRef) != kCVReturnSuccess ||
+        !outTexRef) {
+      CVPixelBufferRelease(pb);
+      return NULL;
+    }
+    id<MTLTexture> outTex = CVMetalTextureGetTexture(outTexRef);
+    id<MTLCommandBuffer> cmd = ensure_cmd(s);
+    if (!outTex || !cmd) {
+      CFRelease(outTexRef);
+      CVPixelBufferRelease(pb);
+      return NULL;
+    }
+
+    // Fast path: single unscaled mapped surface covering the entire output.
+    BOOL fastCovered = NO;
+    if (s->mapOrder.count == 1) {
+      PagaMetalSurface* only = s->surfaces[s->mapOrder[0]];
+      if (only && only.mapped && only.originX == 0 && only.originY == 0 &&
+          only.width == s->outputWidth && only.height == s->outputHeight &&
+          only.targetW == s->outputWidth && only.targetH == s->outputHeight) {
+        id<MTLBlitCommandEncoder> blit = [cmd blitCommandEncoder];
+        [blit copyFromTexture:only.color
+                  sourceSlice:0
+                  sourceLevel:0
+                 sourceOrigin:MTLOriginMake(0, 0, 0)
+                   sourceSize:MTLSizeMake(s->outputWidth, s->outputHeight, 1)
+                    toTexture:outTex
+             destinationSlice:0
+             destinationLevel:0
+            destinationOrigin:MTLOriginMake(0, 0, 0)];
+        [blit endEncoding];
+        fastCovered = YES;
+      }
+    }
+
+    if (!fastCovered) {
+      fill_texture_solid(s, outTex, 0, 0, s->outputWidth, s->outputHeight, 0.0f, 0.0f, 0.0f);
+      for (NSNumber* key in s->mapOrder) {
+        PagaMetalSurface* surf = s->surfaces[key];
+        if (!surf || !surf.mapped) continue;
+        if (surf.originX >= s->outputWidth || surf.originY >= s->outputHeight) continue;
+        if (surf.targetW == surf.width && surf.targetH == surf.height) {
+          uint32_t cw = surf.width < (s->outputWidth - surf.originX)
+                            ? surf.width
+                            : (s->outputWidth - surf.originX);
+          uint32_t ch = surf.height < (s->outputHeight - surf.originY)
+                            ? surf.height
+                            : (s->outputHeight - surf.originY);
+          if (cw == 0 || ch == 0) continue;
+          id<MTLBlitCommandEncoder> blit = [cmd blitCommandEncoder];
+          [blit copyFromTexture:surf.color
+                    sourceSlice:0
+                    sourceLevel:0
+                   sourceOrigin:MTLOriginMake(0, 0, 0)
+                     sourceSize:MTLSizeMake(cw, ch, 1)
+                      toTexture:outTex
+               destinationSlice:0
+               destinationLevel:0
+              destinationOrigin:MTLOriginMake(surf.originX, surf.originY, 0)];
+          [blit endEncoding];
+        } else {
+          id<MTLComputeCommandEncoder> enc = [cmd computeCommandEncoder];
+          BlitScaledParams p = {
+              surf.originX, surf.originY, surf.targetW, surf.targetH, surf.width, surf.height,
+          };
+          [enc setTexture:surf.color atIndex:0];
+          [enc setTexture:outTex atIndex:1];
+          [enc setBytes:&p length:sizeof(p) atIndex:0];
+          dispatch_2d(enc, s->blitScaledPipe, surf.targetW, surf.targetH);
+          [enc endEncoding];
+        }
+      }
+    }
+
+    [cmd commit];
+    [cmd waitUntilCompleted];
+    BOOL failed = (cmd.status == MTLCommandBufferStatusError);
+    s->pendingCmd = nil;
+    CFRelease(outTexRef);
+    CVMetalTextureCacheFlush(s->textureCache, 0);
+    if (failed) {
+      CVPixelBufferRelease(pb);
+      return NULL;
+    }
+    s->dirty = NO;
+    *out_width = s->outputWidth;
+    *out_height = s->outputHeight;
+    return pb;
+  }
+}
--- a/crates/ironrdp-egfx-native/src/vaapi.c
+++ b/crates/ironrdp-egfx-native/src/vaapi.c
@@ -0,0 +1,157 @@
+#include <dlfcn.h>
+#include <errno.h>
+#include <libavcodec/avcodec.h>
+#include <libavutil/hwcontext.h>
+#include <libavutil/pixfmt.h>
+#include <stdbool.h>
+#include <stdint.h>
+#include <stdlib.h>
+#include <string.h>
+
+#define STRING_IMPL(value) #value
+#define STRING(value) STRING_IMPL(value)
+
+#define CODEC_FUNCTIONS(F) \
+  F(avcodec_find_decoder) \
+  F(avcodec_get_hw_config) \
+  F(avcodec_alloc_context3) \
+  F(avcodec_open2) \
+  F(avcodec_free_context) \
+  F(avcodec_flush_buffers) \
+  F(avcodec_send_packet) \
+  F(avcodec_receive_frame) \
+  F(av_packet_alloc) \
+  F(av_packet_free) \
+  F(av_packet_unref) \
+  F(av_new_packet)
+
+#define UTIL_FUNCTIONS(F) \
+  F(av_hwdevice_ctx_create) \
+  F(av_hwframe_transfer_data) \
+  F(av_frame_alloc) \
+  F(av_frame_free) \
+  F(av_frame_unref)
+
+typedef struct {
+  void* codec_library;
+  void* util_library;
+#define DECLARE(fn) __typeof__(&fn) fn;
+  CODEC_FUNCTIONS(DECLARE)
+  UTIL_FUNCTIONS(DECLARE)
+#undef DECLARE
+  AVCodecContext* context;
+  AVPacket* packet;
+  AVFrame* hardware;
+  AVFrame* pixels;
+  int64_t timestamp;
+} PagaVaapi;
+
+typedef struct {
+  const uint8_t* planes[3];
+  size_t strides[3];
+  size_t width, height;
+  bool interleaved_chroma;
+} PagaVaapiPicture;
+
+static enum AVPixelFormat select_vaapi(AVCodecContext* context, const enum AVPixelFormat* formats) {
+  (void)context;
+  for (const enum AVPixelFormat* format = formats; *format != AV_PIX_FMT_NONE; ++format) {
+    if (*format == AV_PIX_FMT_VAAPI) return *format;
+  }
+  return AV_PIX_FMT_NONE;
+}
+
+void paga_rdp_vaapi_close(PagaVaapi* decoder) {
+  if (!decoder) return;
+  if (decoder->packet) decoder->av_packet_free(&decoder->packet);
+  if (decoder->hardware) decoder->av_frame_free(&decoder->hardware);
+  if (decoder->pixels) decoder->av_frame_free(&decoder->pixels);
+  if (decoder->context) decoder->avcodec_free_context(&decoder->context);
+  if (decoder->codec_library) dlclose(decoder->codec_library);
+  if (decoder->util_library) dlclose(decoder->util_library);
+  free(decoder);
+}
+
+PagaVaapi* paga_rdp_vaapi_open(void) {
+  PagaVaapi* decoder = calloc(1, sizeof(*decoder));
+  if (!decoder) return NULL;
+  decoder->util_library = dlopen("libavutil.so." STRING(LIBAVUTIL_VERSION_MAJOR), RTLD_NOW | RTLD_LOCAL);
+  decoder->codec_library = dlopen("libavcodec.so." STRING(LIBAVCODEC_VERSION_MAJOR), RTLD_NOW | RTLD_LOCAL);
+  if (!decoder->codec_library || !decoder->util_library) goto fail;
+#define LOAD_CODEC(fn) if (!(decoder->fn = (__typeof__(&fn))dlsym(decoder->codec_library, #fn))) goto fail;
+#define LOAD_UTIL(fn) if (!(decoder->fn = (__typeof__(&fn))dlsym(decoder->util_library, #fn))) goto fail;
+  CODEC_FUNCTIONS(LOAD_CODEC)
+  UTIL_FUNCTIONS(LOAD_UTIL)
+#undef LOAD_CODEC
+#undef LOAD_UTIL
+  const AVCodec* codec = decoder->avcodec_find_decoder(AV_CODEC_ID_H264);
+  if (!codec) goto fail;
+  for (int i = 0;; ++i) {
+    const AVCodecHWConfig* config = decoder->avcodec_get_hw_config(codec, i);
+    if (!config) goto fail;
+    if (config->device_type == AV_HWDEVICE_TYPE_VAAPI &&
+        config->pix_fmt == AV_PIX_FMT_VAAPI &&
+        (config->methods & AV_CODEC_HW_CONFIG_METHOD_HW_DEVICE_CTX)) break;
+  }
+  decoder->context = decoder->avcodec_alloc_context3(codec);
+  if (!decoder->context) goto fail;
+  if (decoder->av_hwdevice_ctx_create(&decoder->context->hw_device_ctx,
+                                      AV_HWDEVICE_TYPE_VAAPI, NULL, NULL, 0) < 0) goto fail;
+  decoder->context->get_format = select_vaapi;
+  decoder->context->flags |= AV_CODEC_FLAG_LOW_DELAY;
+  decoder->context->thread_count = 1;
+  decoder->context->max_pixels = 16777216;
+  if (decoder->avcodec_open2(decoder->context, codec, NULL) < 0) goto fail;
+  decoder->packet = decoder->av_packet_alloc();
+  decoder->hardware = decoder->av_frame_alloc();
+  decoder->pixels = decoder->av_frame_alloc();
+  if (decoder->packet && decoder->hardware && decoder->pixels) return decoder;
+fail:
+  paga_rdp_vaapi_close(decoder);
+  return NULL;
+}
+
+bool paga_rdp_vaapi_decode(PagaVaapi* decoder, const uint8_t* input, size_t size,
+                          PagaVaapiPicture* result) {
+  decoder->av_frame_unref(decoder->pixels);
+  decoder->av_packet_unref(decoder->packet);
+  if (!size || size > INT32_MAX || decoder->av_new_packet(decoder->packet, (int)size) < 0) return false;
+  memcpy(decoder->packet->data, input, size);
+  decoder->packet->pts = decoder->packet->dts = ++decoder->timestamp;
+  if (decoder->avcodec_send_packet(decoder->context, decoder->packet) < 0) return false;
+  decoder->av_packet_unref(decoder->packet);
+  for (int i = 0; i < 16; ++i) {
+    if (decoder->avcodec_receive_frame(decoder->context, decoder->hardware) < 0) return false;
+    if (decoder->hardware->pts == decoder->timestamp) break;
+    decoder->av_frame_unref(decoder->hardware);
+    if (i == 15) return false;
+  }
+  const bool va_surface = decoder->hardware->format == AV_PIX_FMT_VAAPI;
+  const bool copied = va_surface &&
+      decoder->av_hwframe_transfer_data(decoder->pixels, decoder->hardware, 0) == 0;
+  decoder->av_frame_unref(decoder->hardware);
+  if (!copied) return false;
+  AVFrame* frame = decoder->pixels;
+  if (frame->width <= 0 || frame->height <= 0 ||
+      (int64_t)frame->width * frame->height > 16777216 ||
+      frame->width > UINT16_MAX || frame->height > UINT16_MAX) return false;
+  const bool nv12 = frame->format == AV_PIX_FMT_NV12;
+  if (!nv12 && frame->format != AV_PIX_FMT_YUV420P && frame->format != AV_PIX_FMT_YUVJ420P) return false;
+  result->width = (size_t)frame->width;
+  result->height = (size_t)frame->height;
+  result->interleaved_chroma = nv12;
+  const int chroma_width = (frame->width + 1) / 2;
+  for (int plane = 0; plane < (nv12 ? 2 : 3); ++plane) {
+    const int visible_bytes = plane == 0 ? frame->width : chroma_width * (nv12 ? 2 : 1);
+    if (!frame->data[plane] || frame->linesize[plane] < visible_bytes ||
+        frame->linesize[plane] > UINT16_MAX) return false;
+    result->planes[plane] = frame->data[plane];
+    result->strides[plane] = (size_t)frame->linesize[plane];
+  }
+  return true;
+}
+
+void paga_rdp_vaapi_reset(PagaVaapi* decoder) {
+  decoder->avcodec_flush_buffers(decoder->context);
+  decoder->av_frame_unref(decoder->pixels);
+}
--- a/crates/ironrdp-egfx-native/src/vaapi.rs
+++ b/crates/ironrdp-egfx-native/src/vaapi.rs
@@ -0,0 +1,164 @@
+use core::{ffi::c_void, marker::PhantomData, ptr::NonNull};
+
+use ironrdp_egfx::decode::{DecodedFrame, DecoderError, DecoderResult, H264Decoder, Yuv420Frame};
+
+#[repr(C)]
+#[derive(Default)]
+struct RawPicture {
+    planes: [*const u8; 3],
+    strides: [usize; 3],
+    width: usize,
+    height: usize,
+    interleaved_chroma: bool,
+}
+
+unsafe extern "C" {
+    fn paga_rdp_vaapi_open() -> *mut c_void;
+    fn paga_rdp_vaapi_decode(decoder: *mut c_void, bytes: *const u8, len: usize, result: *mut RawPicture) -> bool;
+    fn paga_rdp_vaapi_reset(decoder: *mut c_void);
+    fn paga_rdp_vaapi_close(decoder: *mut c_void);
+}
+
+struct Picture<'a> {
+    raw: RawPicture,
+    // Data stays valid until we take another exclusive borrow of the decoder.
+    _decoder: PhantomData<&'a mut VaapiDecoder>,
+}
+
+impl Picture<'_> {
+    fn plane(&self, index: usize) -> &[u8] {
+        let rows = if index == 0 {
+            self.raw.height
+        } else {
+            self.raw.height.div_ceil(2)
+        };
+        // Native decode validates width, height, format, non-null planes and
+        // positive pitch. FFmpeg owns the CPU transfer buffers.
+        unsafe { core::slice::from_raw_parts(self.raw.planes[index], self.raw.strides[index] * rows) }
+    }
+}
+
+pub(crate) struct VaapiDecoder(NonNull<c_void>);
+
+// AVCodecContext is confined to one exclusive caller at any moment. FFmpeg
+// and the VA-API driver manage their own internal thread synchronization.
+unsafe impl Send for VaapiDecoder {}
+
+impl VaapiDecoder {
+    pub fn new() -> DecoderResult<Self> {
+        NonNull::new(unsafe { paga_rdp_vaapi_open() })
+            .map(Self)
+            .ok_or_else(|| DecoderError::msg("VA-API H.264 is not available"))
+    }
+
+    fn picture(&mut self, bytes: &[u8]) -> DecoderResult<Picture<'_>> {
+        let mut raw = RawPicture::default();
+        if !unsafe { paga_rdp_vaapi_decode(self.0.as_ptr(), bytes.as_ptr(), bytes.len(), &mut raw) } {
+            return Err(DecoderError::msg("VA-API returned no matching H.264 frame"));
+        }
+        Ok(Picture {
+            raw,
+            _decoder: PhantomData,
+        })
+    }
+}
+
+impl Drop for VaapiDecoder {
+    fn drop(&mut self) {
+        unsafe { paga_rdp_vaapi_close(self.0.as_ptr()) };
+    }
+}
+
+impl H264Decoder for VaapiDecoder {
+    fn supports_yuv420(&self) -> bool {
+        true
+    }
+
+    fn decode(&mut self, bytes: &[u8]) -> DecoderResult<DecodedFrame> {
+        let mut rgba = Vec::new();
+        let (width, height) = self.decode_avc420(bytes, &mut rgba)?;
+        Ok(DecodedFrame::new(rgba, width, height))
+    }
+
+    fn decode_yuv420(&mut self, bytes: &[u8]) -> DecoderResult<Yuv420Frame> {
+        let picture = self.picture(bytes)?;
+        let width = picture.raw.width;
+        let height = picture.raw.height;
+        let chroma_width = width.div_ceil(2);
+        let chroma_rows = height.div_ceil(2);
+        let mut u = Vec::with_capacity(chroma_width * chroma_rows);
+        let mut v = Vec::with_capacity(chroma_width * chroma_rows);
+        if picture.raw.interleaved_chroma {
+            for row in picture.plane(1).chunks_exact(picture.raw.strides[1]) {
+                for pair in row[..chroma_width * 2].chunks_exact(2) {
+                    u.push(pair[0]);
+                    v.push(pair[1]);
+                }
+            }
+        } else {
+            for row in picture.plane(1).chunks_exact(picture.raw.strides[1]) {
+                u.extend_from_slice(&row[..chroma_width]);
+            }
+            for row in picture.plane(2).chunks_exact(picture.raw.strides[2]) {
+                v.extend_from_slice(&row[..chroma_width]);
+            }
+        }
+        Yuv420Frame::new(
+            width as u16,
+            height as u16,
+            picture.plane(0).to_vec(),
+            picture.raw.strides[0],
+            u,
+            v,
+            chroma_width,
+        )
+    }
+
+    fn decode_avc420(&mut self, bytes: &[u8], rgba: &mut Vec<u8>) -> DecoderResult<(u32, u32)> {
+        let picture = self.picture(bytes)?;
+        let width = picture.raw.width as u32;
+        let height = picture.raw.height as u32;
+        let [y_stride, u_stride, v_stride] = picture.raw.strides.map(|stride| stride as u32);
+        rgba.resize(picture.raw.width * picture.raw.height * 4, 0);
+        let result = if picture.raw.interleaved_chroma {
+            yuv::yuv_nv12_to_rgba(
+                &yuv::YuvBiPlanarImage {
+                    y_plane: picture.plane(0),
+                    uv_plane: picture.plane(1),
+                    y_stride,
+                    uv_stride: u_stride,
+                    width,
+                    height,
+                },
+                rgba,
+                width * 4,
+                yuv::YuvRange::Full,
+                yuv::YuvStandardMatrix::Bt709,
+                yuv::YuvConversionMode::Balanced,
+            )
+        } else {
+            yuv::yuv420_to_rgba(
+                &yuv::YuvPlanarImage {
+                    y_plane: picture.plane(0),
+                    u_plane: picture.plane(1),
+                    v_plane: picture.plane(2),
+                    y_stride,
+                    u_stride,
+                    v_stride,
+                    width,
+                    height,
+                },
+                rgba,
+                width * 4,
+                yuv::YuvRange::Full,
+                yuv::YuvStandardMatrix::Bt709,
+            )
+        };
+        result.map_err(|error| DecoderError::new("convert VA-API H.264 picture", error))?;
+        Ok((width, height))
+    }
+
+    fn reset(&mut self) {
+        unsafe { paga_rdp_vaapi_reset(self.0.as_ptr()) };
+    }
+}
--- a/crates/ironrdp-egfx-native/src/video_toolbox.c
+++ b/crates/ironrdp-egfx-native/src/video_toolbox.c
@@ -0,0 +1,193 @@
+#include <CoreMedia/CoreMedia.h>
+#include <CoreVideo/CoreVideo.h>
+#include <VideoToolbox/VideoToolbox.h>
+#include <stdint.h>
+#include <stdlib.h>
+
+typedef struct {
+  VTDecompressionSessionRef session;
+  CMVideoFormatDescriptionRef format;
+  CVPixelBufferRef image;
+  int64_t serial;
+  OSType pixel_format;
+} PagaVideoToolbox;
+
+typedef struct {
+  CVPixelBufferRef image;
+  const uint8_t* y;
+  const uint8_t* uv;
+  size_t y_stride, uv_stride, width, height;
+} PagaVtPlanes;
+
+static void receive_picture(void* context, void* token, OSStatus status,
+                            VTDecodeInfoFlags info, CVImageBufferRef image,
+                            CMTime timestamp, CMTime duration) {
+  PagaVideoToolbox* decoder = context;
+  (void)token;
+  (void)info;
+  (void)duration;
+  // The two consecutive AVC444 views must never be paired with old output.
+  if (status == noErr && image && !decoder->image &&
+      CMTimeCompare(timestamp, CMTimeMake(decoder->serial, 1000)) == 0) {
+    decoder->image = CVPixelBufferRetain(image);
+  }
+}
+
+bool paga_rdp_vt_supported(void) {
+  return VTIsHardwareDecodeSupported(kCMVideoCodecType_H264);
+}
+
+void paga_rdp_vt_close(PagaVideoToolbox* decoder) {
+  if (!decoder) return;
+  if (decoder->session) {
+    VTDecompressionSessionInvalidate(decoder->session);
+    CFRelease(decoder->session);
+  }
+  if (decoder->image) CVPixelBufferRelease(decoder->image);
+  if (decoder->format) CFRelease(decoder->format);
+  free(decoder);
+}
+
+PagaVideoToolbox* paga_rdp_vt_open(const uint8_t* sps, size_t sps_size,
+                                  const uint8_t* pps, size_t pps_size) {
+  const uint8_t* parameters[] = {sps, pps};
+  size_t lengths[] = {sps_size, pps_size};
+  CMVideoFormatDescriptionRef format = NULL;
+  if (CMVideoFormatDescriptionCreateFromH264ParameterSets(
+          NULL, 2, parameters, lengths, 4, &format) != noErr) return NULL;
+  PagaVideoToolbox* decoder = NULL;
+  CFDictionaryRef spec = NULL, output = NULL, iosurface = NULL;
+  CFNumberRef pixel_format = NULL;
+  CMVideoDimensions size = CMVideoFormatDescriptionGetDimensions(format);
+  if (size.width <= 0 || size.height <= 0 || (int64_t)size.width * size.height > 16777216)
+    goto cleanup;
+  const void* spec_key = kVTVideoDecoderSpecification_RequireHardwareAcceleratedVideoDecoder;
+  const void* spec_value = kCFBooleanTrue;
+  spec = CFDictionaryCreate(NULL, &spec_key, &spec_value, 1, &kCFTypeDictionaryKeyCallBacks,
+                            &kCFTypeDictionaryValueCallBacks);
+  // EGFX interprets the encoded samples as full range even when the SPS
+  // omits its VUI range flag. Ask VideoToolbox for the bitstream's range
+  // so it does not rescale the values before the EGFX YUV conversion.
+  CFTypeRef range = CMFormatDescriptionGetExtension(format, kCMFormatDescriptionExtension_FullRangeVideo);
+  const bool full_range = range && CFEqual(range, kCFBooleanTrue);
+  const OSType image_format = full_range ? kCVPixelFormatType_420YpCbCr8BiPlanarFullRange
+                                        : kCVPixelFormatType_420YpCbCr8BiPlanarVideoRange;
+  int32_t format_number = (int32_t)image_format;
+  pixel_format = CFNumberCreate(NULL, kCFNumberSInt32Type, &format_number);
+  iosurface = CFDictionaryCreate(NULL, NULL, NULL, 0, NULL, NULL);
+  if (!spec || !pixel_format || !iosurface) goto cleanup;
+  const void* keys[] = {
+      kCVPixelBufferPixelFormatTypeKey,
+      kCVPixelBufferIOSurfacePropertiesKey,
+      kCVPixelBufferMetalCompatibilityKey,
+  };
+  const void* values[] = {pixel_format, iosurface, kCFBooleanTrue};
+  output = CFDictionaryCreate(NULL, keys, values, 3, &kCFTypeDictionaryKeyCallBacks,
+                              &kCFTypeDictionaryValueCallBacks);
+  if (!output) goto cleanup;
+  decoder = calloc(1, sizeof(*decoder));
+  if (!decoder) goto cleanup;
+  VTDecompressionOutputCallbackRecord callback = {receive_picture, decoder};
+  if (VTDecompressionSessionCreate(NULL, format, spec, output, &callback, &decoder->session)
+      != noErr) {
+    paga_rdp_vt_close(decoder);
+    decoder = NULL;
+  } else {
+    decoder->pixel_format = image_format;
+    decoder->format = (CMVideoFormatDescriptionRef)CFRetain(format);
+    VTSessionSetProperty(decoder->session, kVTDecompressionPropertyKey_RealTime, kCFBooleanTrue);
+  }
+cleanup:
+  if (output) CFRelease(output);
+  if (iosurface) CFRelease(iosurface);
+  if (pixel_format) CFRelease(pixel_format);
+  if (spec) CFRelease(spec);
+  CFRelease(format);
+  return decoder;
+}
+
+static CVPixelBufferRef decode_raw_image(PagaVideoToolbox* decoder, const uint8_t* data,
+                                         size_t length) {
+  CMBlockBufferRef block = NULL;
+  CMSampleBufferRef sample = NULL;
+  CVPixelBufferRef result = NULL;
+  if (decoder->image || length == 0) return NULL;
+  if (CMBlockBufferCreateWithMemoryBlock(NULL, NULL, length, kCFAllocatorDefault,
+                                        NULL, 0, length, kCMBlockBufferAssureMemoryNowFlag, &block) != noErr ||
+      CMBlockBufferReplaceDataBytes(data, block, 0, length) != noErr)
+    goto cleanup;
+  // Request the picture for this sample without temporal reordering.
+  decoder->serial++;
+  CMSampleTimingInfo timing = {kCMTimeInvalid, CMTimeMake(decoder->serial, 1000), kCMTimeInvalid};
+  if (CMSampleBufferCreateReady(NULL, block, decoder->format, 1, 1, &timing,
+                                1, &length, &sample) != noErr)
+    goto cleanup;
+  VTDecodeInfoFlags info = 0;
+  OSStatus status = VTDecompressionSessionDecodeFrame(decoder->session, sample, 0, NULL, &info);
+  OSStatus waited = VTDecompressionSessionWaitForAsynchronousFrames(decoder->session);
+  if (status != noErr || waited != noErr) goto cleanup;
+  CVPixelBufferRef image = decoder->image;
+  if (!image || CVPixelBufferGetPixelFormatType(image) != decoder->pixel_format ||
+      CVPixelBufferGetPlaneCount(image) != 2)
+    goto cleanup;
+  size_t width = CVPixelBufferGetWidth(image), height = CVPixelBufferGetHeight(image);
+  if (!width || !height || width > UINT16_MAX || height > UINT16_MAX ||
+      width * height > 16777216)
+    goto cleanup;
+  result = image;
+  decoder->image = NULL;
+cleanup:
+  if (decoder->image) {
+    CVPixelBufferRelease(decoder->image);
+    decoder->image = NULL;
+  }
+  if (sample) CFRelease(sample);
+  if (block) CFRelease(block);
+  return result;
+}
+
+CVPixelBufferRef paga_rdp_vt_decode_pixel_buffer(PagaVideoToolbox* decoder, const uint8_t* data,
+                                                 size_t length, size_t* out_width,
+                                                 size_t* out_height) {
+  CVPixelBufferRef image = decode_raw_image(decoder, data, length);
+  if (!image) return NULL;
+  *out_width = CVPixelBufferGetWidth(image);
+  *out_height = CVPixelBufferGetHeight(image);
+  return image;
+}
+
+void paga_rdp_vt_release_pixel_buffer(CVPixelBufferRef image) {
+  if (image) CVPixelBufferRelease(image);
+}
+
+bool paga_rdp_vt_decode(PagaVideoToolbox* decoder, const uint8_t* data, size_t length,
+                        PagaVtPlanes* result) {
+  CVPixelBufferRef image = decode_raw_image(decoder, data, length);
+  if (!image) return false;
+  size_t width = CVPixelBufferGetWidth(image), height = CVPixelBufferGetHeight(image);
+  size_t y_stride = CVPixelBufferGetBytesPerRowOfPlane(image, 0);
+  size_t uv_stride = CVPixelBufferGetBytesPerRowOfPlane(image, 1);
+  if (y_stride < width || uv_stride < ((width + 1) / 2) * 2 ||
+      y_stride > UINT16_MAX || uv_stride > UINT16_MAX ||
+      CVPixelBufferGetHeightOfPlane(image, 0) < height ||
+      CVPixelBufferGetHeightOfPlane(image, 1) < (height + 1) / 2 ||
+      CVPixelBufferLockBaseAddress(image, kCVPixelBufferLock_ReadOnly) != kCVReturnSuccess) {
+    CVPixelBufferRelease(image);
+    return false;
+  }
+  const void* y = CVPixelBufferGetBaseAddressOfPlane(image, 0);
+  const void* uv = CVPixelBufferGetBaseAddressOfPlane(image, 1);
+  if (!y || !uv) {
+    CVPixelBufferUnlockBaseAddress(image, kCVPixelBufferLock_ReadOnly);
+    CVPixelBufferRelease(image);
+    return false;
+  }
+  *result = (PagaVtPlanes){image, y, uv, y_stride, uv_stride, width, height};
+  return true;
+}
+
+void paga_rdp_vt_release_frame(CVPixelBufferRef image) {
+  if (!image) return;
+  CVPixelBufferUnlockBaseAddress(image, kCVPixelBufferLock_ReadOnly);
+  CVPixelBufferRelease(image);
+}
