+[numthreads(16, 16, 1)]
+void solid_fill(uint3 gid : SV_DispatchThreadID) {
+    // p0 = (x, y, width, height), f0 = (r, g, b, 1)
+    if (gid.x >= p0.z || gid.y >= p0.w) return;
+    uint dw, dh;
+    dst_rgba.GetDimensions(dw, dh);
+    uint dx = p0.x + gid.x;
+    uint dy = p0.y + gid.y;
