+    fn paga_metal_compositor_create_surface(handle: *mut c_void, id: u16, width: u16, height: u16) -> bool;
+    fn paga_metal_compositor_delete_surface(handle: *mut c_void, id: u16);
+    fn paga_metal_compositor_map_surface(
+        handle: *mut c_void,
