+    left: u16,
+    top: u16,
+    right: u16,
+    bottom: u16,
+}
+
+impl From<&ExclusiveRectangle> for MetalRect {
+    fn from(r: &ExclusiveRectangle) -> Self {
+        Self {
+            left: r.left,
+            top: r.top,
+            right: r.right,
