+        Ok(Self {
+            device,
+            context,
+            fenced_context,
+            fence,
+            fence_event,
+            fence_value: 0,
+            cbuffer,
+            sampler,
+            pipes,
+            surfaces: BTreeMap::new(),
+            map_order: Vec::new(),
+            cache: BTreeMap::new(),
+            budget_used: 0,
+            output_width: 0,
+            output_height: 0,
+            output_ring: Vec::new(),
+            ring_index: 0,
+            pool_generation: 0,
+            dirty: false,
+        })
